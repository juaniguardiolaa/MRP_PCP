{
  "name": "mrp-pcp",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema MRP I para la cátedra de Planificación y Control de la Producción (UTN FRH)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:artifact": "tsc -b && vite build --mode artifact --outDir dist-artifact && node scripts/inline-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
